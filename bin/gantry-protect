#!/bin/sh
# Require status checks on a repo's default branch via a ruleset: `gantry / ci-ok`
# by default, plus any --require. Repo admins can bypass. Idempotent: updates the
# ruleset named "gantry" if it exists, replacing its list of checks, and prints
# the final list.
#
#   gantry-protect [owner/repo] [--dry-run] [--require <check>]... [--no-ci-ok]
#
# --dry-run prints the JSON payload and changes nothing. Without owner/repo,
# uses the repo of the current directory (needs `gh`).
# --require adds a check, named exactly as GitHub reports it. A name that never
# reports leaves every merge waiting. Repeatable.
# --no-ci-ok leaves out `gantry / ci-ok`, for repos without gantry's CI. It needs
# at least one --require.
set -e

NL='
'
CI_OK_CHECK="gantry / ci-ok"

REPO=""; DRY=0; CI_OK=1; REQUIRED=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY=1 ;;
    --no-ci-ok) CI_OK=0 ;;
    --require)
      case "${2:-}" in
        "" | -* | " "* | *" " | *[[:cntrl:]]*) echo "--require needs a check name" >&2; exit 2 ;;
      esac
      REQUIRED="$REQUIRED$2$NL"
      shift
      ;;
    -*) echo "unknown option: $1" >&2; exit 2 ;;
    *)
      # A check name with spaces and no quotes lands here, so don't guess.
      [ -z "$REPO" ] || { echo "unexpected argument: $1 (quote check names that have spaces)" >&2; exit 2; }
      REPO="$1"
      ;;
  esac
  shift
done

if [ "$CI_OK" = 1 ]; then
  REQUIRED="$CI_OK_CHECK$NL$REQUIRED"
else
  [ -n "$REQUIRED" ] || { echo "--no-ci-ok needs at least one --require" >&2; exit 2; }
  case "$NL$REQUIRED" in
    *"$NL$CI_OK_CHECK$NL"*) echo "--no-ci-ok contradicts --require \"$CI_OK_CHECK\"" >&2; exit 2 ;;
  esac
fi

# One JSON entry per check in CHECKS, one name per check in NAMES, no repeats.
CHECKS=""; NAMES=""
set -f; IFS=$NL
for name in $REQUIRED; do
  entry="{ \"context\": \"$(printf '%s' "$name" | sed 's/\\/\\\\/g; s/"/\\"/g')\" }"
  case "$CHECKS" in
    *"$entry"*) ;;
    *)
      CHECKS="$CHECKS${CHECKS:+, }$entry"
      NAMES="$NAMES${NAMES:+, }$name"
      ;;
  esac
done
set +f; unset IFS

PAYLOAD='{
  "name": "gantry",
  "target": "branch",
  "enforcement": "active",
  "conditions": { "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] } },
  "bypass_actors": [
    { "actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always" }
  ],
  "rules": [
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "required_status_checks": [ '"$CHECKS"' ]
      }
    }
  ]
}'

if [ "$DRY" = 1 ]; then
  printf '%s\n' "$PAYLOAD"
  exit 0
fi

[ -n "$REPO" ] || REPO=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
id=$(gh api "repos/$REPO/rulesets" --jq '[.[] | select(.name == "gantry")][0].id // empty')
if [ -n "$id" ]; then
  printf '%s\n' "$PAYLOAD" | gh api -X PUT "repos/$REPO/rulesets/$id" --input - >/dev/null
  echo "updated ruleset gantry ($id) on $REPO"
else
  printf '%s\n' "$PAYLOAD" | gh api -X POST "repos/$REPO/rulesets" --input - >/dev/null
  echo "created ruleset gantry on $REPO"
fi
echo "required checks: $NAMES"

