#!/bin/sh
# Evidence gate for an agent's branch, before its PR is opened or merged. Run it
# in the branch's worktree:
#
#   gantry-gate-evidence [--bug] [--base <ref>] [--remote <name>] [--force-with-lease]
#
# 1. --bug only: the branch needs a commit that adds or changes tests, and
#    nothing else, before its first commit that changes anything else (the fix).
#    Markdown-only commits and test deletions count neither way. A merge counts
#    as everything it brings in over its first parent. Checked first, so a
#    failing branch is never pushed.
# 2. Pushes the branch, so the repo's pre-push hook (lefthook, running gantry's
#    checks) runs. A refused push fails the gate with git's output, hook output
#    included. It never parses CLAUDE.md: the hook decides which checks run.
#
# <remote>'s default branch is refs/remotes/<remote>/HEAD and what
# `git ls-remote --symref <remote> HEAD` names; both are guarded. If neither
# names one, the gate fails closed.
# --base: the branch's base, default <remote>'s default branch, else
# <remote>/main or <remote>/master. Commits are those on HEAD's first-parent
# line and not on the base.
# --remote: default origin.
# --force-with-lease: push with git's lease, for a branch whose history was
# rewritten (a rebase) since its last push.
#
# Fails without pushing on: a detached HEAD; a branch named main, master,
# <remote>'s default or the base's; uncommitted or untracked files, or index
# entries marked assume-unchanged or skip-worktree, or untracked files hidden by
# .git/info/exclude or core.excludesFile (the hook would test the working tree,
# not the commits; only .gitignore may hide a file); <remote>'s default branch
# unknown; no commits ahead of the base; no pre-push hook.
# Fails after pushing if the hook couldn't find lefthook (it exits 0 then).
# The caller's LEFTHOOK* variables and command-line git config are dropped.
#
# Prints `PASS: ...` or `FAIL: <reason>`, then any git output.
# Exit 0: pass; 1: fail; 2: bad arguments.
set -u

NL='
'
TAB=$(printf '\t')
BUG=0; BASE=""; REMOTE=origin; LEASE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --bug) BUG=1 ;;
    --force-with-lease) LEASE=--force-with-lease ;;
    --base | --remote)
      case "${2:-}" in
        "" | -*) echo "$1 needs a value" >&2; exit 2 ;;
      esac
      if [ "$1" = --base ]; then BASE=$2; else REMOTE=$2; fi
      shift
      ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

fail() {
  printf 'FAIL: %s\n' "$1"
  [ -z "${2:-}" ] || printf '%s\n' "$2"
  exit 1
}

# The caller's env must not choose which checks run: every LEFTHOOK* variable
# (LEFTHOOK=0, LEFTHOOK_BIN, LEFTHOOK_CONFIG, LEFTHOOK_EXCLUDE, ...) and git
# config passed through the env (`git -c`, GIT_CONFIG_COUNT) are dropped.
for v in $(env | sed -n 's/^\(LEFTHOOK[A-Za-z0-9_]*\)=.*/\1/p'); do unset "$v"; done
unset GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT
GIT_TERMINAL_PROMPT=0; export GIT_TERMINAL_PROMPT

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || fail "not inside a git work tree"
BRANCH=$(git symbolic-ref --short -q HEAD) || fail "HEAD is detached; check out the work branch"
cd "$(git rev-parse --show-toplevel)" || fail "can't cd to the work tree's top level"

# <remote>'s default branch, as the local ref has it and as the remote says: the
# local ref may be unset (a plain `git remote add` and fetch) or stale.
LOCAL_DEFAULT=$(git symbolic-ref --short -q "refs/remotes/$REMOTE/HEAD" 2>/dev/null) || LOCAL_DEFAULT=""
LOCAL_DEFAULT=${LOCAL_DEFAULT#"$REMOTE"/}
REMOTE_DEFAULT=$(git ls-remote --symref "$REMOTE" HEAD 2>/dev/null |
  awk '$1 == "ref:" && $3 == "HEAD" { sub(/^refs\/heads\//, "", $2); print $2; exit }') || REMOTE_DEFAULT=""
[ -n "$LOCAL_DEFAULT$REMOTE_DEFAULT" ] ||
  fail "can't determine $REMOTE's default branch: refs/remotes/$REMOTE/HEAD is unset and \`git ls-remote --symref $REMOTE HEAD\` names none, so the gate can't tell whether $BRANCH is it"
if [ -z "$BASE" ]; then
  for b in "$LOCAL_DEFAULT" "$REMOTE_DEFAULT" main master; do
    [ -n "$b" ] && git rev-parse -q --verify "refs/remotes/$REMOTE/$b" >/dev/null && { BASE=$REMOTE/$b; break; }
  done
  [ -n "$BASE" ] || fail "can't find $REMOTE's default branch; pass --base <ref>"
fi
git rev-parse -q --verify "$BASE^{commit}" >/dev/null || fail "base $BASE is not a commit"

# Never push to a branch that may be the default, whatever --base says.
base_name=${BASE#refs/remotes/}; base_name=${base_name#refs/heads/}; base_name=${base_name#"$REMOTE"/}
for p in main master "$LOCAL_DEFAULT" "$REMOTE_DEFAULT" "$base_name"; do
  [ -n "$p" ] && [ "$BRANCH" = "$p" ] && fail "on $BRANCH, a default or base branch; the gate pushes work branches only"
done

dirty=$(git -c status.showUntrackedFiles=all -c core.fsmonitor=false \
  status --porcelain --untracked-files=all --ignore-submodules=none) || fail "git status failed"
[ -z "$dirty" ] || fail "uncommitted or untracked files; the pre-push hook would test them, not the commits" "$dirty"
# git status hides untracked files matched by .git/info/exclude or
# core.excludesFile; only the repo's own .gitignore files may hide one.
untracked=$(git -c core.fsmonitor=false ls-files --others --exclude-per-directory=.gitignore) ||
  fail "git ls-files failed"
[ -z "$untracked" ] || fail "untracked files, hidden from git status by .git/info/exclude or core.excludesFile; the pre-push hook would test them, not the commits. Commit, delete or .gitignore them" "$untracked"
hidden=$(git ls-files -v | grep -E '^([a-z]|S) ') || hidden=""
[ -z "$hidden" ] || fail "index entries marked assume-unchanged or skip-worktree hide working-tree changes from git status; clear them (git update-index --no-assume-unchanged / --no-skip-worktree)" "$hidden"

COMMITS=$(git rev-list --reverse --first-parent "$BASE..HEAD") || fail "can't list commits since $BASE"
[ -n "$COMMITS" ] || fail "no commits on $BRANCH ahead of $BASE"

# test, md or code. Shell test scripts and *.bats are tests (shinfactory#215).
kind() {
  b=${1##*/}
  case "$b" in *.md | *.markdown) echo md; return ;; esac
  case "/$1" in */test/* | */tests/* | */__tests__/* | */spec/*) echo test; return ;; esac
  case "$b" in
    *.bats | *.test.* | *.spec.* | *_test.* | *_spec.* | test_*.py | \
    test.sh | tests.sh | test-*.sh | test_*.sh | *-test.sh) echo test ;;
    *) echo code ;;
  esac
}

# A commit's kind: code if it changes any code file (deletions included), else
# test if it adds or changes a test, else none (Markdown only, test deletions
# only, or empty). A merge is diffed against its first parent.
commit_kind() {
  if git rev-parse -q --verify "$1^2" >/dev/null; then
    changes=$(git -c core.quotePath=false diff-tree -r --name-status "$1^1" "$1")
  else
    changes=$(git -c core.quotePath=false diff-tree -r --no-commit-id --name-status --root "$1")
  fi
  k=none
  set -f; IFS=$NL
  for line in $changes; do
    st=${line%%"$TAB"*}; f=${line#*"$TAB"}
    case $(kind "$f") in
      code) k="code"; break ;;
      test) [ "$st" = D ] || k="test" ;;
    esac
  done
  set +f; unset IFS
  echo "$k"
}

if [ "$BUG" = 1 ]; then
  offenders=""; tested=0
  for c in $COMMITS; do
    case $(commit_kind "$c") in
      test) tested=1; break ;;
      code)
        line=$(git log -1 --format='%h %s' "$c")
        git rev-parse -q --verify "$c^2" >/dev/null && line="$line (merge)"
        offenders="$offenders  $line$NL"
        ;;
    esac
  done
  if [ -n "$offenders" ]; then
    if [ "$tested" = 1 ]; then why="these commits change non-test files before the first test-only commit:"
    else why="no test-only commit comes before these, which change non-test files:"; fi
    fail "bug work needs a commit that changes only tests before the fix; $why" "${offenders%"$NL"}"
  fi
fi

# A push with no pre-push hook would pass without running a check.
hook=$(git rev-parse --git-path hooks/pre-push)
[ -f "$hook" ] && [ -x "$hook" ] || fail "no pre-push hook at $hook, so pushing runs no checks; run \`lefthook install\`"

# shellcheck disable=SC2086 # $LEASE is empty or one flag
out=$(git push $LEASE -u "$REMOTE" "HEAD:refs/heads/$BRANCH" 2>&1) ||
  fail "push of $BRANCH refused by the pre-push hook or $REMOTE; git push said:" "$out"
# lefthook's hook prints this and exits 0 when it can't find the binary.
case "$out" in
  *"Can't find lefthook in PATH"*)
    fail "pushed $BRANCH, but the pre-push hook couldn't find lefthook, so no check ran; install lefthook (or the repo's node_modules) and rerun" "$out" ;;
esac
printf 'PASS: pushed %s at %s to %s; pre-push hook passed\n' "$BRANCH" "$(git rev-parse HEAD)" "$REMOTE"
printf '%s\n' "$out"
