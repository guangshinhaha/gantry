#!/bin/sh
# Apply gantry to a repo: lefthook.yml, CI workflow, CLAUDE.md skeleton.
# Never overwrites existing files. Safe to re-run. Formats only the files it adds.
#
#   gantry-init [repo-dir] [--prisma] [--nextjs] [--no-mutation] [--review] [--docker] [--ac-check] [--preview [railway|vercel]]
set -e

GANTRY_DIR="$(cd "$(dirname "$0")/.." && pwd)"
TARGET="."
PREVIEW=""; PREVIEW_FLAG=0; PRISMA=0; NEXTJS=0; MUTATION=1; REVIEW=0; DOCKER=0; AC_CHECK=0
WANT_PV=0
for arg in "$@"; do
  if [ "$WANT_PV" = 1 ]; then
    WANT_PV=0
    case "$arg" in railway|vercel) PREVIEW="$arg"; continue ;; esac
  fi
  case "$arg" in
    --preview) PREVIEW_FLAG=1; WANT_PV=1 ;;
    --prisma) PRISMA=1 ;;
    --nextjs) NEXTJS=1 ;;
    --no-mutation) MUTATION=0 ;;
    --review) REVIEW=1 ;;
    --docker) DOCKER=1 ;;
    --ac-check) AC_CHECK=1 ;;
    *) TARGET="$arg" ;;
  esac
done
cd "$TARGET"
git rev-parse --git-dir >/dev/null 2>&1 || { echo "not a git repo: $(pwd)"; exit 1; }

ADDED="" # every path is a fixed name with no spaces, so this splits safely
copy() { # src dest
  if [ -e "$2" ]; then echo "  keep   $2 (exists)"
  else mkdir -p "$(dirname "$2")"; cp "$1" "$2"; echo "  add    $2"; ADDED="$ADDED $2"; fi
}

# Format what we added, or a repo's format:check goes red on the next PR (#13).
# Runs the repo's local binary, because its format script would format everything.
format_added() {
  [ -n "$ADDED" ] || return 0
  files="$ADDED"; ADDED=""
  tool=""
  if [ -f package.json ]; then tool=$(node "$GANTRY_DIR/bin/formatter-plan.mjs" 2>/dev/null) || tool=unknown; fi
  case "$tool" in
    "") echo "  skip   format (no oxfmt, biome or prettier in package.json). If you use another formatter, run it before committing."; return 0 ;;
    oxfmt) flags="--no-error-on-unmatched-pattern" ;;
    biome) flags="format --write --no-errors-on-unmatched --files-ignore-unknown=true" ;;
    prettier) flags="--write --ignore-unknown --no-error-on-unmatched-pattern" ;;
    *) echo "  ! Can't tell which single formatter to run on the added files. Run your formatter before committing."; return 0 ;;
  esac
  if [ ! -x "node_modules/.bin/$tool" ]; then
    echo "  ! $tool is not installed, so the added files are unformatted. Install dependencies and run your formatter before committing."
  elif out=$("node_modules/.bin/$tool" $flags $files 2>&1); then
    echo "  format added files with $tool"
  else
    echo "  ! $tool failed on the added files. Run your formatter before committing."
    echo "$out"
  fi
}
# A later step can abort (set -e), and a re-run would see these files as kept.
trap format_added EXIT

echo "gantry → $(pwd)"
copy "$GANTRY_DIR/template/lefthook.yml" lefthook.yml
copy "$GANTRY_DIR/template/.github/workflows/ci.yml" .github/workflows/ci.yml
copy "$GANTRY_DIR/template/.github/workflows/secrets-scan.yml" .github/workflows/secrets-scan.yml

# Preview smoke tests: only when we know the platform (detected or --preview).
if [ -z "$PREVIEW" ]; then
  if [ -f railway.json ] || [ -f railway.toml ]; then PREVIEW=railway
  elif [ -f vercel.json ] || [ -e .vercel ]; then PREVIEW=vercel; fi
fi
if [ -n "$PREVIEW" ]; then
  if [ -e .github/workflows/preview.yml ]; then echo "  keep   .github/workflows/preview.yml (exists)"
  else
    mkdir -p .github/workflows
    sed "s|__PLATFORM__|$PREVIEW|" "$GANTRY_DIR/template/.github/workflows/preview.yml" > .github/workflows/preview.yml
    echo "  add    .github/workflows/preview.yml (platform: $PREVIEW)"
    ADDED="$ADDED .github/workflows/preview.yml"
  fi
elif [ -e .github/workflows/preview.yml ]; then echo "  keep   .github/workflows/preview.yml (exists)"
else echo "  skip   preview smoke tests (no railway.json/vercel.json found; add with: gantry-init --preview railway|vercel)"
fi
copy "$GANTRY_DIR/template/.github/workflows/risky-paths.yml" .github/workflows/risky-paths.yml
copy "$GANTRY_DIR/template/gantry-risky-paths" .github/gantry-risky-paths

# Acceptance-criteria check: opt-in, because it can only see that a box is
# ticked, not that the claim is true. A repo that already has the workflow keeps
# it and gets the template it needs.
[ -e .github/workflows/ac-check.yml ] && AC_CHECK=1
if [ "$AC_CHECK" = 1 ]; then
  copy "$GANTRY_DIR/template/.github/workflows/ac-check.yml" .github/workflows/ac-check.yml
  copy "$GANTRY_DIR/template/.github/pull_request_template.ac-check.md" .github/pull_request_template.md
  grep -qiE '^#{1,6}[[:space:]]*acceptance criteria[[:space:]]*:?[[:space:]]*#*[[:space:]]*$' .github/pull_request_template.md ||
    echo "  ! .github/pull_request_template.md has no Acceptance criteria section. ac-check fails a PR that closes an issue with a checklist unless the PR body repeats it."
else
  copy "$GANTRY_DIR/template/.github/pull_request_template.md" .github/pull_request_template.md
fi

copy "$GANTRY_DIR/template/CLAUDE.md" CLAUDE.md

# Docker build-and-verify (never pushes): opt-in. GovPaaS (Northflank), Railway
# and Vercel build the image themselves; only AWS apps push to ECR.
[ "$DOCKER" = 1 ] && copy "$GANTRY_DIR/template/.github/workflows/build.yml" .github/workflows/build.yml

# Mutation testing: on by default for single-package Vitest/Jest repos.
if [ "$MUTATION" = 1 ] && [ -f package.json ]; then
  if ls stryker.config.* stryker.conf.* >/dev/null 2>&1; then
    echo "  keep   stryker config (exists)"
    copy "$GANTRY_DIR/template/.github/workflows/mutation.yml" .github/workflows/mutation.yml
  else
    plan=$(node "$GANTRY_DIR/bin/stryker-plan.mjs" "$GANTRY_DIR/template/stryker.config.mjs") || plan="off: could not read package.json"
    case "$plan" in
      off:*) echo "  skip   mutation testing (${plan#off: })" ;;
      *)
        # A failed install, or one that leaves vitest <2 (pnpm only warns on the peer),
        # turns mutation off: package.json and the lockfiles go back as they were,
        # and the rest of gantry-init still runs (#14).
        echo "  install $plan"
        if [ -f pnpm-lock.yaml ]; then pm="pnpm add -D"; else pm="npm install -D"; fi
        bak=$(mktemp -d); manifests="package.json package-lock.json npm-shrinkwrap.json pnpm-lock.yaml yarn.lock"
        for f in $manifests; do [ -f "$f" ] && cp "$f" "$bak/"; done
        why=""
        if ! out=$($pm $plan 2>&1); then why="the Stryker install failed"
        elif case "$plan" in *vitest-runner*) true ;; *) false ;; esac &&
          [ "$(node -p 'require("./node_modules/vitest/package.json").version.split(".")[0] < 2' 2>/dev/null)" = true ]; then
          why="the installed vitest is <2, and the Stryker runner needs 2+"; out=""
        fi
        if [ -z "$why" ]; then
          copy "$GANTRY_DIR/template/.github/workflows/mutation.yml" .github/workflows/mutation.yml
          echo "  add    stryker.config.mjs"
          ADDED="$ADDED stryker.config.mjs"
          for l in ".stryker-tmp/" "reports/mutation/" "reports/stryker-incremental.json"; do
            grep -qxF "$l" .gitignore 2>/dev/null || echo "$l" >> .gitignore
          done
        else
          [ -n "$out" ] && echo "$out"
          for f in $manifests; do
            if [ -f "$bak/$f" ]; then cp "$bak/$f" "$f"; else rm -f "$f"; fi
          done
          rm -f stryker.config.mjs
          echo "  ! $why, so mutation testing is off and package.json is unchanged. Fix it, then re-run gantry-init."
        fi
        rm -rf "$bak"
        ;;
    esac
  fi
fi

# Second review by Claude: opt-in, because it sends PR diffs to Anthropic (PDPA).
if [ "$REVIEW" = 1 ]; then
  copy "$GANTRY_DIR/template/.github/workflows/review.yml" .github/workflows/review.yml
  echo "  ! review needs the ANTHROPIC_API_KEY repo secret; set it yourself."
fi

# Uncomment opt-in configs.
[ "$PRISMA" = 1 ] && sed -i '' 's|# - hooks/prisma.yml|- hooks/prisma.yml|' lefthook.yml
[ "$NEXTJS" = 1 ] && sed -i '' 's|# - hooks/nextjs.yml|- hooks/nextjs.yml|' lefthook.yml

format_added

if [ -d .husky ] || [ -n "$(git config --local core.hooksPath)" ]; then
  echo
  echo "  ! This repo uses husky (core.hooksPath=$(git config --local core.hooksPath))."
  echo "    lefthook was NOT installed. To switch: port any repo-only checks into"
  echo "    lefthook.yml, then: git config --unset core.hooksPath && lefthook install"
  exit 0
fi

command -v lefthook >/dev/null || { echo "install lefthook first: brew install lefthook"; exit 1; }
lefthook install
echo "done. Commit the added files (lefthook.yml, .github/workflows/, stryker.config.mjs, package.json)."
