#!/bin/sh
# Apply gantry to a repo: lefthook.yml, CI workflow, CLAUDE.md skeleton.
# Never overwrites existing files. Safe to re-run.
#
#   gantry-init [repo-dir] [--prisma] [--nextjs]
set -e

GANTRY_DIR="$(cd "$(dirname "$0")/.." && pwd)"
TARGET="."
PRISMA=0; NEXTJS=0
for arg in "$@"; do
  case "$arg" in
    --prisma) PRISMA=1 ;;
    --nextjs) NEXTJS=1 ;;
    *) TARGET="$arg" ;;
  esac
done
cd "$TARGET"
git rev-parse --git-dir >/dev/null 2>&1 || { echo "not a git repo: $(pwd)"; exit 1; }

copy() { # src dest
  if [ -e "$2" ]; then echo "  keep   $2 (exists)"
  else mkdir -p "$(dirname "$2")"; cp "$1" "$2"; echo "  add    $2"; fi
}

echo "gantry → $(pwd)"
copy "$GANTRY_DIR/template/lefthook.yml" lefthook.yml
copy "$GANTRY_DIR/template/.github/workflows/ci.yml" .github/workflows/ci.yml
copy "$GANTRY_DIR/template/CLAUDE.md" CLAUDE.md

# Uncomment opt-in configs.
[ "$PRISMA" = 1 ] && sed -i '' 's|# - hooks/prisma.yml|- hooks/prisma.yml|' lefthook.yml
[ "$NEXTJS" = 1 ] && sed -i '' 's|# - hooks/nextjs.yml|- hooks/nextjs.yml|' lefthook.yml

if [ -d .husky ] || [ -n "$(git config --local core.hooksPath)" ]; then
  echo
  echo "  ! This repo uses husky (core.hooksPath=$(git config --local core.hooksPath))."
  echo "    lefthook was NOT installed. To switch: port any repo-only checks into"
  echo "    lefthook.yml, then: git config --unset core.hooksPath && lefthook install"
  exit 0
fi

command -v lefthook >/dev/null || { echo "install lefthook first: brew install lefthook"; exit 1; }
lefthook install
echo "done. Commit lefthook.yml and .github/workflows/ci.yml."
